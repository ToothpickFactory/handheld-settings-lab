  .scope-warning p { margin: 6px 0 0; color: #d6d0c2; }
  .step-grid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 12px; margin: 22px 0 34px; }
  .step-card { padding: 18px; border: 1px solid rgba(184,255,77,.25); border-radius: 14px; background: #10150d; }
  .step-card > span { display: grid; place-items: center; width: 32px; height: 32px; margin-bottom: 12px; border: 1px solid #b8ff4d; border-radius: 50%; color: #b8ff4d; font-weight: 900; }
  .step-card h3 { margin: 0 0 8px; font-size: 1rem; }
  .step-card p { margin: 0; color: #c4ccd8; font-size: .9rem; }
