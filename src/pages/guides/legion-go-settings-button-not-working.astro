  .symptom-table th { color: #b8ff4d; background: #111722; text-align: left; }
  .symptom-table th, .symptom-table td { padding: 14px 16px; border-bottom: 1px solid rgba(255,255,255,.09); vertical-align: top; }
  .symptom-table tbody tr:last-child td { border-bottom: 0; }
