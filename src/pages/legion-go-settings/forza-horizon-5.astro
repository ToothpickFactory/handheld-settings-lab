---
import Base from '../../layouts/Base.astro';

const canonicalUrl = 'https://handheldsettings.com/legion-go-settings/forza-horizon-5/';
const title = 'Forza Horizon 5 Legion Go settings: 800p/40 baseline — Handheld Settings Lab';
const description = 'Tune Forza Horizon 5 on the original Lenovo Legion Go from a cautious 800p/40 FPS baseline, then test 60 FPS, image quality, storage, controls, and docked play.';
const image = '/assets/games/forza-horizon-5-header.jpg';

const sources = [
  { label: 'Steam: Forza Horizon 5 requirements, features, and official media', url: 'https://store.steampowered.com/app/1551360/Forza_Horizon_5/' },
  { label: 'Steam app-details API: current public product data for app 1551360', url: 'https://store.steampowered.com/api/appdetails?appids=1551360&cc=us&l=en' },
  { label: 'Xbox: official Forza Horizon 5 product page', url: 'https://www.xbox.com/en-US/games/forza-horizon-5' },
  { label: 'Lenovo PSREF: original Legion Go 8APU1 specifications', url: 'https://psref.lenovo.com/Product/Legion/Legion_Go_8APU1' }
];

const faqs = [
  {
    question: 'What Forza Horizon 5 settings should I use on Legion Go?',
    answer: 'Start at 1280×800, a 40 FPS cap, the Low preset, and a Quality-oriented temporal upscaling option if the current build offers one. Run the built-in benchmark, then repeat a busy wet road and an off-road event before raising textures, environment detail, or the frame cap. This is an official-source-informed test baseline, not a personally measured guarantee.'
  },
  {
    question: 'Can Legion Go run Forza Horizon 5 at 60 FPS?',
    answer: 'Treat 60 FPS as a profile to test, not a guaranteed result. Keep 800p, start from Low, use a performance-class device profile, and validate a crowded festival area, rain, night driving, and off-road effects. Return to 40 or 30 FPS if the weakest repeatable scene cannot hold the higher target consistently.'
  },
  {
    question: 'Should I use 800p or 1200p for Forza Horizon 5 on Legion Go?',
    answer: 'Use 800p for the first performance baseline because it preserves the display’s 16:10 shape while reducing graphics load substantially. Test 1200p only after the 800p profile has clear headroom, and change resolution without simultaneously changing power mode, preset, or frame cap.'
  },
  {
    question: 'What graphics setting should I lower first in Forza Horizon 5?',
    answer: 'Use the benchmark and warning indicators first. For scene-heavy slowdown, reduce environment geometry, world car detail, shadows, reflections, particles, and shader quality before sacrificing interface clarity. If memory warnings or streaming hitches appear, lower texture and environment texture quality and confirm free SSD space.'
  },
  {
    question: 'How much storage does Forza Horizon 5 need on PC?',
    answer: 'Steam currently lists 110GB of available space. Leave additional room for game updates, shader data, Windows temporary files, recordings, and other launchers rather than filling the drive to exactly 110GB.'
  },
  {
    question: 'Were these Forza Horizon 5 Legion Go settings personally benchmarked?',
    answer: 'No. Handheld Settings Lab did not personally benchmark the current game build, Windows version, graphics driver, firmware, Legion Space version, battery, thermals, race, or online session. The page provides a reproducible baseline and makes no measured frame-rate claim.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Forza Horizon 5 Legion Go settings: 800p/40 FPS baseline',
    description,
    image: `https://handheldsettings.com${image}`,
    url: canonicalUrl,
    datePublished: '2026-08-11',
    dateModified: '2026-08-11',
    author: { '@type': 'Organization', name: 'Handheld Settings Lab' },
    publisher: { '@type': 'Organization', name: 'Handheld Settings Lab', url: 'https://handheldsettings.com/' },
    about: ['Forza Horizon 5', 'Lenovo Legion Go', 'game settings', 'frame rate', 'handheld PC']
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://handheldsettings.com/' },
      { '@type': 'ListItem', position: 2, name: 'Legion Go settings', item: 'https://handheldsettings.com/legion-go-settings/' },
      { '@type': 'ListItem', position: 3, name: 'Forza Horizon 5 settings', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer }
    }))
  }
];
---
<Base title={title} description={description} image={image} jsonLd={jsonLd}>
  <article class="wrap article">
    <span class="eyebrow">Legion Go settings · Baseline published August 2026</span>
    <h1>Forza Horizon 5 Legion Go settings: start at 800p and 40 FPS</h1>
    <p class="lede muted">Forza Horizon 5 moves quickly between open roads, dense festival sites, weather, night lighting, traffic, and off-road particles. This original Legion Go workflow starts at a cautious 800p/40 Low profile, uses the built-in benchmark for repeatability, and then checks real driving before restoring image quality. It is official-source-informed guidance—not a personally tested benchmark.</p>

    <figure class="game-hero">
      <img src={image} alt="Official Forza Horizon 5 artwork with a red Mercedes-AMG One on a tropical road beside a beach and off-road vehicle" width="460" height="215" />
      <figcaption class="media-credit">Official Forza Horizon 5 Steam store header image, saved locally from <a href="https://store.steampowered.com/app/1551360/Forza_Horizon_5/" target="_blank" rel="nofollow noopener">Xbox Game Studios' Steam store page</a>. Artwork and trademarks belong to their owners; editorial use does not imply endorsement.</figcaption>
    </figure>

    <div class="settings-panel">
      <section class="card"><h3>Test target</h3><div class="stat">800p / 40</div><p class="muted">Cautious target, not a lock guarantee</p></section>
      <section class="card"><h3>Starting preset</h3><div class="stat">Low</div><p class="muted">Restore detail after validation</p></section>
      <section class="card"><h3>Higher-FPS test</h3><p><strong>800p / 60</strong></p><p class="muted">Only after 40 FPS holds up</p></section>
      <section class="card"><h3>Storage floor</h3><div class="stat">110GB</div><p class="muted">Current Steam requirement</p></section>
    </div>

    <div class="callout"><strong>Benchmark, then drive:</strong> the built-in benchmark creates a repeatable comparison, but it cannot represent every race. Follow it with the same wet-road route, crowded festival pass, and off-road event before calling a profile stable.</div>

    <h2>Recommended Forza Horizon 5 Legion Go baseline</h2>
    <table>
      <thead><tr><th>Control</th><th>Start here</th><th>Reason</th></tr></thead>
      <tbody>
        <tr><td>Legion Go power mode</td><td>Performance-class profile</td><td>Creates a repeatable first condition. Record whether the device is on battery or connected directly to a compatible charger.</td></tr>
        <tr><td>Display refresh rate</td><td>60Hz for baseline</td><td>Provides a simple starting relationship for 30, 40, and 60 FPS comparisons without changing several variables at once.</td></tr>
        <tr><td>Screen mode / resolution</td><td>Fullscreen / 1280×800</td><td>Preserves the panel's 16:10 shape while reducing load from 1200p or native 2560×1600.</td></tr>
        <tr><td>Frame-rate cap</td><td>40 FPS</td><td>Offers a practical middle target for responsive driving while retaining more headroom than an assumed 60 FPS lock.</td></tr>
        <tr><td>Graphics preset</td><td>Low</td><td>Establishes a conservative diagnostic floor before restoring visual detail setting by setting.</td></tr>
        <tr><td>Dynamic optimization</td><td>Off for the first comparison</td><td>A fixed profile makes cause and effect easier to understand. Test dynamic settings later as a separate profile.</td></tr>
        <tr><td>Upscaling / anti-aliasing</td><td>Quality-oriented temporal mode, if available</td><td>Starts with the clearest reconstruction option exposed by the current build. Use only one scaling method during diagnosis.</td></tr>
        <tr><td>Textures</td><td>Medium after the Low baseline passes</td><td>Road, car, and environment detail are valuable; raise textures first while watching the game's memory indicator and new streaming hitches.</td></tr>
        <tr><td>Anisotropic filtering</td><td>Medium or 8×</td><td>Improves road and ground texture clarity at angles without being the first control to cut during a scene-load problem.</td></tr>
        <tr><td>Shadows / reflections</td><td>Low</td><td>Preserves headroom across changing sun, headlights, wet roads, bodywork, and dense roadside scenes.</td></tr>
        <tr><td>World cars / environment geometry</td><td>Low</td><td>Busy festival areas and traffic can expose scene complexity that an empty road does not.</td></tr>
        <tr><td>Particles / deformable terrain</td><td>Low</td><td>Protects the target during dust, water spray, collisions, and off-road racing before reducing nearby texture clarity.</td></tr>
        <tr><td>Motion blur</td><td>Preference; fixed during tests</td><td>Choose the look you prefer, but keep it unchanged while comparing frame pacing and image reconstruction.</td></tr>
      </tbody>
    </table>
    <p class="muted">Available labels, upscalers, presets, and dynamic-quality behavior can change with updates. Use the closest normal in-game option, photograph the current menu, and do not combine an in-game scaler with unexplained driver scaling during the baseline.</p>

    <h2>A repeatable benchmark and driving test</h2>
    <ol>
      <li><strong>Finish updates first.</strong> Complete the game, Steam, Xbox sign-in components, Windows, Lenovo firmware/software, graphics driver, and Legion Space updates, then restart.</li>
      <li><strong>Record the device state.</strong> Note game version, driver, firmware, power mode, charger state, resolution, refresh rate, cap, upscaler, and background downloads.</li>
      <li><strong>Apply 800p/40 Low.</strong> Keep dynamic optimization off initially so each later change has a clear cause.</li>
      <li><strong>Run the built-in benchmark twice.</strong> Treat the first pass as warm-up and save the second result plus any memory or quality warnings.</li>
      <li><strong>Repeat a real route.</strong> Include traffic, a festival area, fast camera movement, wet pavement or night lighting when available, and an off-road event with dust or water.</li>
      <li><strong>Separate one-time stutter from sustained misses.</strong> Repeat the route before changing settings; asset or shader activity on one pass is not the same as repeatable overload.</li>
      <li><strong>Restore clarity one control at a time.</strong> Try textures, anisotropic filtering, and environment texture quality before raising expensive reflections or geometry.</li>
      <li><strong>Test 60 FPS as a new profile.</strong> Keep 800p and Low, raise only the cap, and abandon the higher target if the weakest scene becomes inconsistent.</li>
    </ol>

    <h2>Choose 40, 60, or 30 FPS deliberately</h2>
    <div class="grid cols3">
      <section class="card"><span class="chip">Balanced baseline</span><h3>800p / 40 FPS</h3><p>Use this page's starting profile for a responsive middle ground. Validate rain, traffic, festival scenes, and off-road effects before increasing quality.</p></section>
      <section class="card"><span class="chip">Response priority</span><h3>800p / 60 FPS test</h3><p>Start from Low and change only the cap. Keep it only when the weakest repeatable route remains stable enough for your standards.</p></section>
      <section class="card"><span class="chip">Consistency priority</span><h3>800p / 30 FPS fallback</h3><p>Use a 30 FPS cap when the same demanding scenes repeatedly miss 40, or when reducing power draw matters more than steering response.</p></section>
    </div>

    <h2>Fix common Forza Horizon 5 issues on Legion Go</h2>
    <table>
      <thead><tr><th>Symptom</th><th>Check first</th><th>Next step</th></tr></thead>
      <tbody>
        <tr><td>Festival or city slowdown</td><td>Confirm 800p, Low preset, 40 FPS cap, and low world-car, geometry, shadow, and reflection settings</td><td>Return to one Quality/Balanced upscaler path, stop background work, and repeat the same route</td></tr>
        <tr><td>Off-road effects cause drops</td><td>Lower particles, deformable terrain, and environment geometry</td><td>Compare the same event and weather before reducing textures or the frame cap</td></tr>
        <tr><td>Memory warning or texture hitching</td><td>Return textures and environment textures to Low; check free SSD space</td><td>Close overlays and background apps, restart, rerun the benchmark, and raise one memory-heavy setting at a time</td></tr>
        <tr><td>Image looks too soft</td><td>Confirm one upscaler and a Quality-oriented mode</td><td>Restore anisotropic filtering, then compare 1200p only after the 800p target is repeatable</td></tr>
        <tr><td>Uneven camera motion</td><td>Confirm one frame cap and the recorded refresh rate</td><td>Remove overlapping in-game, overlay, or driver caps and retest without recording software</td></tr>
        <tr><td>Controls switch to keyboard prompts</td><td>Set Legion Space controls to gamepad mode</td><td>Restore the default Steam Input layout and reconnect external controllers one at a time</td></tr>
        <tr><td>Online or sign-in failure</td><td>Confirm network, Steam, and Xbox account status</td><td>Complete an online launch and sync before relying on the game away from home</td></tr>
        <tr><td>Docked play performs worse</td><td>Retest on the handheld display with power connected directly</td><td>Check dock power and TV output separately; do not default to native 4K rendering</td></tr>
      </tbody>
    </table>

    <h2>Storage, battery, online, and dock planning</h2>
    <p>Steam currently lists <strong>110GB of available space</strong>, DirectX 12, broadband internet, full controller support, Steam Cloud, and cross-platform multiplayer. Leave extra capacity for updates, shader data, captures, Windows temporary files, and another version rollback rather than filling the drive to exactly 110GB. Use the <a href="/calculators/storage-planner/">storage planner</a>, then read the <a href="/guides/handheld-pc-ssd-form-factor-guide/">handheld SSD form-factor guide</a> before buying internal storage.</p>
    <p>This page does not invent a battery-runtime range. Brightness, radios, power mode, cap, scene complexity, battery health, heat, and background downloads all affect total draw. Record your own observed power use and enter it in the <a href="/calculators/battery-estimator/">battery estimator</a>. Before travel, complete an online launch, confirm the exact account and save, and follow the <a href="/guides/handheld-pc-offline-mode-flight-checklist/">offline-mode checklist</a>; online events and multiplayer still require connectivity.</p>
    <p>Establish the handheld profile before moving to a television. Then use the <a href="/guides/handheld-gaming-usb-c-dock-checklist/">USB-C dock checklist</a>. A 4K desktop signal does not mean Forza Horizon 5 should render internally at 4K on the handheld.</p>

    <h2>Optional gear after the profile is stable</h2>
    <p class="affiliate-note">Disclosure: these are broad Amazon searches marked sponsored/nofollow, not hands-on endorsements. Compare exact specifications, fit, seller traceability, warranty, and return terms. No price, compatibility, performance, or battery claim is made; a real Associates tag is appended only when configured.</p>
    <div class="grid cols3">
      <a class="card gear-card" href="https://www.amazon.com/s?k=legion+go+usb+c+pd+dock+65w" target="_blank" rel="nofollow sponsored" data-affiliate-link data-category="docks"><span class="chip">Sponsored search</span><h3>Legion Go USB-C docks</h3><p class="muted">Check PD passthrough, display modes, cable reach, physical clearance, and support for the exact Legion Go model.</p></a>
      <a class="card gear-card" href="https://www.amazon.com/s?k=legion+go+65w+usb+c+pd+charger" target="_blank" rel="nofollow sponsored" data-affiliate-link data-category="chargers"><span class="chip">Sponsored search</span><h3>65W-class USB-C PD chargers</h3><p class="muted">Verify dedicated-port output, cable rating, shared-port behavior, warranty, and exact-device support.</p></a>
      <a class="card gear-card" href="https://www.amazon.com/s?k=legion+go+ssd+upgrade" target="_blank" rel="nofollow sponsored" data-affiliate-link data-category="ssds"><span class="chip">Sponsored search</span><h3>Legion Go SSD upgrades</h3><p class="muted">Verify the exact model's form factor, interface, thermal fit, seller, recovery plan, and warranty before opening the handheld.</p></a>
    </div>
    <p>Compare categories in the <a href="/gear/">spec-based gear library</a>, follow the <a href="/guides/legion-go-accessories-buying-checklist/">Legion Go accessory buying order</a>, or set a limit with the <a href="/calculators/accessory-budget/">accessory budget calculator</a>.</p>

    <h2>Frequently asked questions</h2>
    <div class="grid cols2">
      {faqs.map(faq => <section class="card"><h3>{faq.question}</h3><p>{faq.answer}</p></section>)}
    </div>

    <h2>Sources and methodology</h2>
    <p>Sources were checked on August 11, 2026. Steam's live store page and public app-details API supplied the November 9, 2021 PC release date, 110GB storage requirement, desktop minimum and recommended specifications, DirectX 12 and broadband requirements, controller and multiplayer feature labels, developer/publisher identity, and official image. Xbox supplies the official product page. Lenovo PSREF supplies the original Legion Go product route and hardware context.</p>
    <p>The settings are a conservative editorial test sequence derived from those official constraints, the game's built-in benchmark, and normal graphics-diagnosis practice. Handheld Settings Lab did not personally benchmark the current game, Windows build, driver, firmware, Legion Space, battery, thermals, route, race, or online session. No search-volume or guaranteed-frame-rate claim is made.</p>
    <ul>{sources.map(source => <li><a href={source.url} target="_blank" rel="nofollow noopener">{source.label}</a></li>)}</ul>
    <p>Return to the <a href="/legion-go-settings/">Legion Go settings hub</a>, reduce accessory guesswork with the <a href="/guides/legion-go-first-week-settings-accessories/">Legion Go first-week checklist</a>, or use the <a href="/calculators/">battery, storage, and accessory calculators</a> with your own observations.</p>
  </article>
</Base>
