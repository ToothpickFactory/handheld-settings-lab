---
import Base from '../../layouts/Base.astro';
import { games } from '../../data/games';
const platform = Astro.url.pathname.includes('rog-ally') ? 'ROG Ally' : 'Steam Deck';
const slug = platform === 'ROG Ally' ? 'rog-ally-settings' : 'steam-deck-settings';
const additionalGames = platform === 'ROG Ally' ? [
  {
    slug: 'baldurs-gate-3',
    title: "Baldur's Gate 3",
    deckFps: '',
    allyFps: '30+ FPS ASUS-tested range',
    storage: 150,
    preset: '1080p / 25W Turbo + FSR 2 Quality'
  },
  {
    slug: 'arc-raiders',
    title: 'ARC Raiders',
    deckFps: '',
    allyFps: '30 FPS test baseline',
    storage: 'Check current install',
    preset: '720p Low + Quality upscaling'
  },
  {
    slug: 'red-dead-redemption-2',
    title: 'Red Dead Redemption 2',
    deckFps: '',
    allyFps: '30 FPS test baseline',
    storage: 150,
    preset: '720p Low–medium + FSR 2 Quality'
  },
  {
    slug: 'forza-horizon-5',
    title: 'Forza Horizon 5',
    deckFps: '',
    allyFps: '60 FPS test baseline',
    storage: 110,
    preset: '720p Low + Quality upscaling'
  },
  {
    slug: 'apex-legends',
    title: 'Apex Legends',
    deckFps: '',
    allyFps: '60 FPS baseline',
    storage: 75,
    preset: '720p Low + adaptive target'
  }
] : [];
const listedGames = [...games, ...additionalGames];
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage',name:`${platform} game settings`,url:`https://handheldsettings.com/${slug}/`,mainEntity:{'@type':'ItemList',itemListElement:listedGames.map((game,i)=>({'@type':'ListItem',position:i+1,name:`${game.title} ${platform} settings`,url:`https://handheldsettings.com/${slug}/${game.slug}/`}))}};
---
<Base title={`${platform} game settings: FPS, battery and storage guides — Handheld Settings Lab`} description={`Browse ${platform} settings for popular games with FPS targets, storage estimates, battery planning, tuning checklists, and source-aware guidance.`} jsonLd={jsonLd}>
<section class="section"><div class="wrap"><span class="eyebrow">{platform} settings database</span><h1 style="font-size:clamp(2.6rem,6vw,5.4rem);line-height:1;letter-spacing:-.06em">{platform} game settings</h1><p class="lede">Find a stable starting point for popular games, then tune for frame pacing, battery life, storage, and visual quality. Each page distinguishes planning guidance from documented testing.</p>{platform === 'ROG Ally' && <aside class="callout"><strong>New guide:</strong> Start with the <a href="/rog-ally-settings/baldurs-gate-3/">official ASUS-tested Baldur's Gate 3 profile</a>, or compare <a href="/rog-ally-settings/arc-raiders/">ARC Raiders</a> and <a href="/rog-ally-settings/forza-horizon-5/">Forza Horizon 5</a>.</aside>}<table class="table"><thead><tr><th>Game</th><th>Target</th><th>Storage</th><th>Preset</th></tr></thead><tbody>{listedGames.map(game => <tr><td><a href={`/${slug}/${game.slug}/`}><strong>{game.title}</strong></a></td><td>{platform === 'ROG Ally' ? game.allyFps : game.deckFps}</td><td>{typeof game.storage === 'number' ? `${game.storage}GB` : game.storage}</td><td>{game.preset}</td></tr>)}</tbody></table><div class="grid cols2" style="margin-top:28px"><section class="card"><h2>How to use these settings</h2><ol><li>Set the target frame rate first.</li><li>Test a demanding area, not only a menu.</li><li>Lower shadows, volumetrics, and crowds before textures.</li><li>Reduce power gradually after frame pacing is stable.</li><li>Recheck after major game, driver, BIOS, or firmware updates.</li></ol></section><section class="card"><h2>Plan the full handheld setup</h2><p>Performance is only part of the experience. Leave room for patches, estimate battery needs before travel, and choose accessories that match the exact device.</p><p><a href="/calculators/storage-planner/">Storage planner</a> · <a href="/calculators/battery-estimator/">Battery estimator</a> · <a href="/gear/">Gear guides</a></p></section></div><h2 style="margin-top:34px">Frequently asked questions</h2><h3>Are these guaranteed benchmarks?</h3><p>No. Unless direct test notes are explicitly shown, settings are baseline recommendations informed by public specs, patch notes, store requirements, and credible community reports.</p><h3>Why prioritize a frame cap?</h3><p>A stable 30, 40, or 60 FPS target usually feels better than constantly changing frame rates. It also gives you a repeatable baseline for battery and graphics adjustments.</p><h3>How often should settings be updated?</h3><p>Recheck after major game patches, graphics driver updates, firmware/BIOS changes, or device power-profile updates.</p></div></section>
</Base>
